# ========================================================
# BK Group: Motors & Properties Monorepo Environment Configuration
# Duplicate this file to .env and populate your actual values.
# ========================================================

NODE_ENV=development

# --------------------------------------------------------
# LangGraph AI Engine (ai-service)
# --------------------------------------------------------
# NVIDIA NIM API Key (Free tier available at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter Fallback API Key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# --------------------------------------------------------
# Strapi Headless CMS (cms)
# --------------------------------------------------------
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified_salt_here
ADMIN_JWT_SECRET=tobemodified_admin_jwt_secret_here
TRANSFER_TOKEN_SALT=tobemodified_transfer_token_salt_here
JWT_SECRET=tobemodified_client_jwt_secret_here

# Database Configuration (Defaults to SQLite for local development)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production MySQL settings (e.g. for cPanel or Cloud SQL):
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=bkmotors_db
# DATABASE_USERNAME=bkmotors_user
# DATABASE_PASSWORD=strong_database_password_here
# DATABASE_SSL=false

# --------------------------------------------------------
# Frontend & API Connection URLs
# --------------------------------------------------------
STRAPI_API_URL=http://localhost:1337
STRAPI_PUBLIC_URL=http://localhost:1337
AI_SERVICE_URL=http://localhost:8000
